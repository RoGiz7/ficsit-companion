{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FICSIT Companion",
  "version": "0.1.0",
  "identifier": "com.rogiz7.ficsitcompanion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FICSIT Companion",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/icons/*",
            "$APPDATA/icons/**/*"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "RoGiz7",
    "copyright": "Copyright (c) 2026 RoGiz7",
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "shortDescription": "Desktop companion for Satisfactory",
    "longDescription": "Reads your Satisfactory save files and shows your factory inventory, real production with overclock, bottlenecks, stored materials, a 2D map and how everything has grown over time. Local-only and read-only: it never writes to your saves.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RoGiz7/ficsit-companion/releases/latest/download/latest.json"
      ],
      "pubkey": "PEGAR_AQUI_LA_CLAVE_PUBLICA",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
